<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Switch
            android:id="@+id/sw_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_service" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/et_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/settings_name_hint" />

            <Button
                android:id="@+id/btn_save_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save" />
        </LinearLayout>

        <Switch
            android:id="@+id/sw_big_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_big_font" />

        <TextView
            android:id="@+id/tv_threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_threshold" />

        <TextView
            android:id="@+id/tv_zone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_set_zone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_zone" />

        <Button
            android:id="@+id/btn_clear_zone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_zone" />

        <TextView
            android:id="@+id/tv_blacklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_blacklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_blacklist" />

        <Button
            android:id="@+id/btn_clear_blacklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_blacklist" />

        <Button
            android:id="@+id/btn_background_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_bg_location" />

        <Button
            android:id="@+id/btn_events_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/events_clear_short" />
    </LinearLayout>
</ScrollView>
